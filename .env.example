# Stored local data and demo mode work without credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nomadai_travel_discovery/0.2
GOOGLE_PLACES_API_KEY=
S3_BUCKET_NAME=
AWS_DEFAULT_REGION=us-east-1

# AWS may use its standard credential chain or an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional standalone AI planner (install the ai extra).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional override of the app's local data directory.
NOMADAI_DATA_DIR=

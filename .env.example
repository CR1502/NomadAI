# Stored local data and demo mode work without credentials.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nomadai_travel_discovery/0.2
GOOGLE_PLACES_API_KEY=
# basic = Pro fields; standard adds Enterprise ratings/prices/hours/contact fields.
GOOGLE_PLACES_DETAIL_LEVEL=standard
S3_BUCKET_NAME=
AWS_DEFAULT_REGION=us-east-1

# AWS may use its standard credential chain or an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Default opt-in AI backend: your installed local Gemma model via Ollama.
# Run ollama serve if the local service is not already running. No model is downloaded automatically.
NOMADAI_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b

# Optional cloud backend (select OpenAI in the UI and install the ai extra).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Publish your own policy pages before public deployment with Google Places.
# They must meet Google's Terms of Use / Privacy Policy requirements.
TERMS_OF_USE_URL=
PRIVACY_POLICY_URL=

# Optional override of the app's local data directory.
NOMADAI_DATA_DIR=
